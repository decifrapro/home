# ─────────────────────────────────────────────────────────────
# DECIFRA PRO — exemplo de configuração
# Copie para .env e ajuste. Nunca versione o .env real.
# ─────────────────────────────────────────────────────────────

# Identidade do aplicativo (backend e frontend leem daqui)
APP_NAME=Decifra Pro
APP_SHORT_NAME=Decifra
APP_DESCRIPTION=Leitor multimodal de conversas exportadas do WhatsApp

# Servidor. Os nomes levam APP_ na frente porque HOST e PORT são usados pelas
# hospedagens, e uma delas chegando vazia derrubaria a configuração.
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Origens liberadas para o frontend em desenvolvimento (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Onde guardar os atendimentos ─────────────────────────────
# Servidor próprio (Docker, VPS, seu computador): deixe o Supabase em branco
# e os dados ficam em disco, num banco SQLite.
DATA_DIR=/data
# Caminho do banco. Vazio: <DATA_DIR>/decifra.sqlite3
DATABASE_PATH=

# Vercel: preencha os dois campos abaixo e o sistema passa a guardar tudo no
# Supabase — banco e arquivos. É o modo sem disco e sem FFmpeg (vídeo não é
# analisado e áudio acima de 24 MB fica de fora).
# A chave de serviço fica só no servidor. Nunca coloque no frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=decifra
SUPABASE_TABLE_PREFIX=decifra_

# Processamento em blocos, para caber no tempo da função da Vercel
TICK_BUDGET_SECONDS=45
# No plano gratuito da Vercel a função morre em 60 s: use 40 aqui.
TICK_MAX_ITEMS=8
# Senha do agendamento automático (/api/cron/tick). Vazia: aceita só a chamada
# interna da Vercel.
CRON_SECRET=

# Gate de acesso. Vazio = sem senha. Preenchido = exige login antes do upload.
APP_ACCESS_PASSWORD=
# Segredo de assinatura do cookie de sessão. Vazio: gerado a cada boot.
APP_SESSION_SECRET=

# ── Limites ──────────────────────────────────────────────────
MAX_ZIP_MB=500
MAX_UNCOMPRESSED_MB=2000
MAX_FILES_PER_ZIP=5000
MAX_SINGLE_FILE_MB=500
MAX_COMPRESSION_RATIO=120
UPLOAD_CHUNK_MB=5
JOB_RETENTION_HOURS=24

# ── Provedor de IA (Parte 2) ─────────────────────────────────
# Sem chave o sistema roda em modo somente-motor: a timeline é montada,
# as mídias ficam pendentes e o job termina como "parcial".
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=180

# ── Concorrência ─────────────────────────────────────────────
AUDIO_CONCURRENCY=3
IMAGE_CONCURRENCY=3
PDF_CONCURRENCY=2
VIDEO_CONCURRENCY=1
LINK_CONCURRENCY=3
PROVIDER_MAX_RETRIES=4

# ── Mídia ────────────────────────────────────────────────────
VIDEO_MAX_FRAMES=16
AUDIO_CHUNK_MAX_MB=20
AUDIO_CHUNK_SECONDS=600
PDF_MAX_PAGES=300
PDF_MIN_CHARS_PER_PAGE=180
LINK_TIMEOUT_SECONDS=20
LINK_MAX_DOWNLOAD_MB=8
# Fallback com navegador headless para páginas que dependem de JavaScript.
ENABLE_PLAYWRIGHT=false

# ── Custo ────────────────────────────────────────────────────
MAX_JOB_COST_USD=5
# Confirmar automaticamente o processamento de IA (sem passar pela tela de estimativa)
AUTO_CONFIRM_PROCESSING=true
# Preços usados só para estimar e registrar custo (USD). Ajuste conforme seu contrato.
PRICE_TRANSCRIPTION_PER_MINUTE=0.006
PRICE_VISION_INPUT_PER_MTOK=0.40
PRICE_VISION_OUTPUT_PER_MTOK=1.60
